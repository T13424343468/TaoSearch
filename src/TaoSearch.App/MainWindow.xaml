<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TaoSearch.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="TaoSearch">

    <Grid Background="{ThemeResource PaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：搜索框 + 范围切换 -->
        <Grid Grid.Row="0" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     PlaceholderText="输入文件名或内容关键词…"
                     FontSize="{StaticResource FontBody}"
                     CornerRadius="{StaticResource InputRadius}"
                     TextChanged="OnSearchTextChanged" />
            <ToggleSwitch x:Name="ContentToggle"
                          Grid.Column="1" Margin="12,0,0,0"
                          OnContent="含内容" OffContent="仅文件名"
                          Toggled="OnScopeToggled" />
        </Grid>

        <!-- 状态行 -->
        <TextBlock Grid.Row="1" x:Name="StatusText"
                   Margin="18,0,16,8"
                   Style="{StaticResource AuxText}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

        <!-- 结果列表 -->
        <ScrollViewer Grid.Row="2" Margin="16,0,16,8">
            <ListView x:Name="ResultList" ItemsSource="{x:Bind ViewModel.Hits, Mode=OneWay}"
                      SelectionChanged="OnResultSelected">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HitViewModel"
                                  xmlns:vm="using:TaoSearch.App.ViewModels">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind FileName}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Path}" Style="{StaticResource AuxText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource AuxText}" />
                                <ItemsControl ItemsSource="{x:Bind Segments}" Visibility="{x:Bind Snippet, Converter={StaticResource NullToCollapsedConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="{StaticResource FontAux}"
                                                       Foreground="{Binding IsMatch, Converter={StaticResource MatchToBrushConverter}}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- 底部导航（原型六页口径：主窗/快速/引导/设置/集成） -->
        <NavigationView Grid.Row="3" x:Name="Nav"
                        PaneDisplayMode="Bottom"
                        SelectionChanged="OnNavChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="搜索" Tag="main" IsSelected="True" />
                <NavigationViewItem Content="设置" Tag="settings" />
            </NavigationView.MenuItems>
        </NavigationView>
        <ContentControl Grid.Row="3" x:Name="OverlayHost" Visibility="Collapsed" />
    </Grid>
</Window>
