<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TaoSearch.App.QuickSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TaoSearch 快速搜索">

    <Grid x:Name="Root" Background="{ThemeResource CardBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 输入行：即输即搜 -->
        <Grid Grid.Row="0" Padding="16,12,16,12" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="QuickInput"
                     Grid.Column="1"
                     PlaceholderText="搜索文件名或内容…"
                     FontSize="16"
                     BorderThickness="0"
                     Background="Transparent"
                     TextChanged="OnInputChanged" />
            <Border Grid.Column="2" Padding="6,2" CornerRadius="4"
                    Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                <TextBlock Text="Esc" FontSize="12" Foreground="{ThemeResource Ink2Brush}" />
            </Border>
        </Grid>

        <!-- 结果列表：最多 8 条，键盘上下选择 -->
        <ListView Grid.Row="1" x:Name="QuickList"
                  MaxHeight="384"
                  SelectionChanged="OnResultSelected"
                  Padding="8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Margin="8,6">
                        <TextBlock Text="{Binding FileName}" FontSize="14" Foreground="{ThemeResource InkBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{ThemeResource Ink3Brush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空态 -->
        <StackPanel Grid.Row="1" x:Name="QuickEmpty" Visibility="Visible"
                    VerticalAlignment="Center" Spacing="8" Margin="32,0" HorizontalAlignment="Center">
            <TextBlock x:Name="EmptyTitle" Text="快速搜索" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyDesc" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{ThemeResource Ink3Brush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 底部快捷键提示（按状态切换文案） -->
        <Border Grid.Row="2" Background="{ThemeResource Surface2Brush}" Padding="16,8"
                BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FootHint" FontSize="12" Foreground="{ThemeResource Ink3Brush}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
