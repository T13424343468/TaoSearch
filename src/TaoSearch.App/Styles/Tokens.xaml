<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- 瓷釉语义令牌（水墨浅色基线；深色主题随系统切换由 ThemeResource 覆盖） -->
    <Color x:Key="PaperColor">#FFFFFF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#F4F6F9</Color>
    <Color x:Key="InkColor">#1A1A1A</Color>
    <Color x:Key="Ink2Color">#5C5C5C</Color>
    <Color x:Key="Ink3Color">#8A8A8A</Color>
    <Color x:Key="AzureColor">#2563EB</Color>
    <Color x:Key="AzurewColor">#E8F1FA</Color>
    <Color x:Key="DeepColor">#1E40AF</Color>
    <Color x:Key="LineColor">#E5E5E5</Color>
    <Color x:Key="CinColor">#B3261E</Color>
    <Color x:Key="CinwColor">#FBEEED</Color>

    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Ink2Brush" Color="{StaticResource Ink2Color}" />
    <SolidColorBrush x:Key="Ink3Brush" Color="{StaticResource Ink3Color}" />
    <SolidColorBrush x:Key="AzureBrush" Color="{StaticResource AzureColor}" />
    <SolidColorBrush x:Key="AzurewBrush" Color="{StaticResource AzurewColor}" />
    <SolidColorBrush x:Key="DeepBrush" Color="{StaticResource DeepColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="CinBrush" Color="{StaticResource CinColor}" />
    <SolidColorBrush x:Key="CinwBrush" Color="{StaticResource CinwColor}" />

    <!-- 字号档位（4/8 网格） -->
    <x:Double x:Key="FontTitle">20</x:Double>
    <x:Double x:Key="FontBody">14</x:Double>
    <x:Double x:Key="FontAux">12</x:Double>

    <!-- 圆角档位 -->
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <CornerRadius x:Key="InputRadius">6</CornerRadius>
</ResourceDictionary>
